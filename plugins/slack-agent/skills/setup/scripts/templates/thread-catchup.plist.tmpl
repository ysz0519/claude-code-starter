<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.claude-slack-agent.thread-catchup</string>
	<!-- ProgramArguments[0] は必ず /bin/bash にする。
	     macOS の TCC はバイナリ単位で許可を出すため、~/Documents 等の保護領域にある
	     スクリプトを /usr/bin/python3 等から直接起動すると Operation not permitted で全回失敗する。 -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>@@RUN_SH@@</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@@WORKDIR@@</string>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>StandardOutPath</key>
	<string>/tmp/claude-slack-agent-thread-catchup.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/claude-slack-agent-thread-catchup.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>@@HOME@@</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
</dict>
</plist>
